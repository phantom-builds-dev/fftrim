{
    "name": "fftrim",
    "version": "1.0.1",
    "description": "Video trimming and compression",
    "main": "./out/main/index.js",
    "private": true,
    "license": "GPL-3.0-or-later",
    "author": {
        "name": "phantom-builds"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/phantom-builds-dev/fftrim"
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
        "checksums": "node build/checksums.mjs",
        "release:win": "npm run build:win && npm run checksums"
    },
    "dependencies": {
        "@electron-toolkit/utils": "^4.0.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "electron-log": "^5.4.4",
        "ffmpeg-static": "^5.3.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@electron/fuses": "^2.1.3",
        "@phosphor-icons/react": "^2.1.10",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^6.0.3",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    }
}
